# Copy this file to .env and fill in real values. Never commit .env.

# --- apps/api ---

# Server
NODE_ENV=development
PORT=4000

# Database (MySQL by default — see apps/api/src/config/database.ts for
# how the engine is detected from these variables)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth (session cookie + JWT — see apps/api/src/auth)
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=h360_auth
# Origin allowed to send credentialed requests (apps/web dev server)
WEB_ORIGIN=http://localhost:5173

# Seed script only — creates the single demo case-manager user (see apps/api/prisma/seed.ts)
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_FIRST_NAME=
SEED_USER_LAST_NAME=

# SSN encryption (client-intake-wizard) — 32-byte keys, hex-encoded (64 hex chars).
# SSN_ENCRYPTION_KEY encrypts the stored value (AES-256-GCM, see apps/api/src/utils/ssn.ts);
# SSN_HASH_SECRET is a separate key for the deterministic duplicate-matching hash (HMAC-SHA256).
# Never reuse JWT_SECRET here, and never commit real values. The app fails to start if either is unset.
SSN_ENCRYPTION_KEY=
SSN_HASH_SECRET=

# --- apps/web ---

# Base URL the frontend uses to reach the API (Vite env var, must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:4000
