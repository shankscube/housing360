# Copy this file to .env and fill in real values. Never commit .env.

# --- apps/api ---

# Server
NODE_ENV=development
PORT=4000

# Database (MySQL by default — see apps/api/src/config/database.ts for
# how the engine is detected from these variables)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- apps/web ---

# Base URL the frontend uses to reach the API (Vite env var, must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:4000
